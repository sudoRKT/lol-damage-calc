{
  "name": "lol-damage-calc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-based League of Legends damage simulator. Calculation runs entirely in the browser; no server, no database, no accounts.",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:coverage && tsc --noEmit && vite build",
    "preview": "vite preview",
    "fetch:data": "node scripts/fetch/index.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:coverage": "node scripts/site/build-coverage.ts",
    "patch:check": "node scripts/fetch/patch-pipeline.ts --dry-run",
    "patch:apply": "node scripts/fetch/patch-pipeline.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/saira": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
