{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // The data-pipeline scripts under scripts/ are run directly by Node (v26 strips types
    // natively), so their relative imports must carry the .ts extension. Safe here only
    // because noEmit is true — nothing is compiled to disk.
    "allowImportingTsExtensions": true,

    "types": ["vitest/globals", "node"]
  },
  // scripts/ is typechecked too, so the generated data files are held to the same frozen
  // shapes in src/types/ that the app is.
  "include": ["src", "scripts"]
}
